# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/
# Dopo il deploy: verifica in Network (DevTools) che le risposte statiche riportino gli header attesi.

# Font binari: cache lunga (rinominare i file se cambi contenuto e vuoi invalidare subito i client)
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Foglio @font-face: cache più breve così aggiornamenti a montserrat.css si propagano in giorni
/fonts/montserrat.css
  Cache-Control: public, max-age=604800, must-revalidate

/images/flags/*.svg
  Cache-Control: public, max-age=2592000, must-revalidate

/logo/*
  Cache-Control: public, max-age=2592000, must-revalidate

/favicon/*
  Cache-Control: public, max-age=2592000, must-revalidate

/components/*
  Cache-Control: public, max-age=86400, must-revalidate

/css/*
  Cache-Control: public, max-age=604800, must-revalidate

/js/*
  Cache-Control: public, max-age=86400, must-revalidate

/asset/icon/*
  Cache-Control: public, max-age=2592000, must-revalidate

/asset/media/*
  Cache-Control: public, max-age=2592000, must-revalidate

/asset/payments_logo/*
  Cache-Control: public, max-age=2592000, must-revalidate

# Indice della ricerca: i risultati mostrano anche il prezzo, quindi vale la
# stessa nota del cross-sell qui sotto — nessun token ?v= da bustare (l'URL lo
# costruisce components/header.js), e il client chiede l'indice con
# `cache: 'no-cache'`, cioe' sempre in revalidazione. Questo max-age vale per le
# cache intermedie.
/asset/search-index/*
  Cache-Control: public, max-age=86400, must-revalidate

# Indice del cross-sell: contiene prezzi mostrati a video, quindi cache piu'
# corta della ricerca — un listino cambiato non deve restare in giro un giorno.
# L'URL non ha un token ?v= da bustare (lo costruisce js/cart-cross-sell.js, non
# l'HTML, quindi bump-asset-version.py non lo vede): il client lo compensa
# chiedendolo con `cache: 'no-cache'`, cioe' sempre in revalidazione. Questo
# max-age vale per le cache intermedie.
/asset/cross-sell/*
  Cache-Control: public, max-age=3600, must-revalidate

# Nessuna regola per /.well-known/apple-developer-merchantid-domain-association:
# la registrazione del dominio presso Stripe (Settings → Payments → Domini delle
# modalità di pagamento) verifica quell'URL, e un file statico nostro la
# oscurerebbe facendola fallire. Va servito da Stripe, non da noi.

# Security headers. La Content-Security-Policy NON sta qui: Cloudflare Pages
# scarta senza errore le righe di _headers oltre ~2000 caratteri e la nostra CSP
# e' piu' lunga. Viene servita da functions/_middleware.js (const CSP).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(self "https://js.stripe.com")
