# Copia questo file in `.dev.vars` per lo sviluppo locale (wrangler pages dev).
# `.dev.vars` è in .gitignore: NON committare valori reali.

# Obbligatoria per i token della thank-you page (qualsiasi stringa lunga va bene in dev)
TOKEN_SECRET=stringa-random-di-almeno-32-caratteri

# Rate-limit checkout (HMAC email). Obbligatoria: senza di essa create-order risponde 503.
FRAUD_HASH_SECRET=dev-fraud-hash-secret-min-32-chars!!

# PayPal SANDBOX per i test locali (in produzione si usano i secret live)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=<client-id-sandbox>
PAYPAL_CLIENT_SECRET=<client-secret-sandbox>

# Facoltative in dev: se assenti le email non partono (comportamento gestito)
# RESEND_API_KEY=re_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Pannello admin senza Cloudflare Access in locale
# ADMIN_DEV_BYPASS=1

# Modulo consulenza: valida il flusso locale senza inviare email reali.
# Non impostare in produzione.
CONSULTATION_DRY_RUN=1

# Support chat locale (nessun account cliente: guest-only)
CHAT_ENABLED=1
CHAT_GUEST_SESSION_SECRET=dev-chat-guest-secret-change-me-32-chars-minimum
CHAT_CONTACT_LOOKUP_SECRET=dev-chat-contact-secret-change-me-32-chars-minimum
CHAT_GUEST_SESSION_DAYS=180
CHAT_GUEST_COOKIE_NAME=aml_chat_guest_dev
CHAT_ARCHIVE_AFTER_DAYS=30
CHAT_RETENTION_DAYS=180
CHAT_SPAM_RETENTION_DAYS=14
CHAT_DELETE_GRACE_DAYS=0
CHAT_TOMBSTONE_RETENTION_DAYS=30
CHAT_RETENTION_BATCH_SIZE=100
CHAT_MAX_MESSAGE_LENGTH=4000
VAPID_PUBLIC_KEY=<chiave-pubblica-generata-con-npx-web-push-generate-vapid-keys>
VAPID_PRIVATE_KEY=<chiave-privata-locale-non-committare>
VAPID_SUBJECT=mailto:Info@amlstore.it

# Conservazione dei carrelli tracciati (analytics). Facoltative: senza di esse
# valgono i default indicati. La pulizia gira da sola, in coda alle richieste,
# al massimo una volta all'ora.
#   fase 1 — l'email viene azzerata, la riga resta e continua a fare statistica
# CART_ANONYMIZE_AFTER_DAYS=30
#   fase 2 — la riga viene cancellata (non può essere inferiore alla fase 1)
# CART_DELETE_AFTER_DAYS=180
